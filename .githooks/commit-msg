#!/bin/sh
# This hook removes co-author lines from every commit message.
# It also removes "Generated with Claude" lines.
# Enable it once per clone: git config core.hooksPath .githooks

message_file="$1"
clean_file="$(mktemp)" || exit 1

# grep returns 1 when no line is left. Git then stops the empty commit itself.
grep -viE '^[[:space:]]*co-authored-by:|generated (with|by) .*claude' "$message_file" > "$clean_file"

cat "$clean_file" > "$message_file"
/bin/rm -f "$clean_file"
exit 0
